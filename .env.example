# Copy this file to `.env` and fill in your credentials.

# ---------- Frontend WhatsApp (Twilio API) ----------
# To send WhatsApp directly from the frontend, add these Vite env vars.
# WARNING: This exposes your Twilio Account SID and Auth Token in client code.
# Use ONLY with restricted API keys or in development/demo apps.
# For production, use a backend server instead (see backend section below).
VITE_TWILIO_ACCOUNT_SID=your_account_sid
VITE_TWILIO_AUTH_TOKEN=your_auth_token
VITE_TWILIO_WHATSAPP_FROM=+14155238886
VITE_TO_WHATSAPP=+917358961672

# ---------- EmailJS (frontend) ----------
# If you use EmailJS to send emails from the browser, set these Vite vars
# (must start with VITE_ so Vite exposes them to client code):
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ---------- Optional: SMTP server (backend) ----------
# If you run the Express server and prefer SMTP email, fill these.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=no-reply@yourdomain.com
TO_EMAIL=you@yourdomain.com

# ---------- Optional: Twilio WhatsApp (server) ----------
# To send a WhatsApp message from the backend when someone submits the form,
# sign up for Twilio, enable the WhatsApp sender (a Twilio WhatsApp-enabled number),
# then add these values to your local `.env` file.
# Example TO_WHATSAPP for Indian number: +917358961672
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+1415XXXXXXX   # Twilio WhatsApp-enabled number (no 'whatsapp:' prefix in server code)
TO_WHATSAPP=+917358961672

# Server listen port (optional)
# PORT=3000

